              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "// Tests for Update Donator Status",
                    "pm.test(\"Status code is 200\", function () {",
                    "    pm.response.to.have.status(200);",
                    "});",
                    "",
                    "pm.test(\"Donator status updated\", function () {",
                    "    var jsonData = pm.response.json();",
                    "    var donator = jsonData.donators.find(d => d.donatorId === pm.environment.get('donatorId'));",
                    "    pm.expect(donator).to.have.property('status', 'No Response');",
                    "});"
                  ]
                }
              }
            ]
