{
    "info": {
        "name": "Notes API",
        "description": "API collection for managing notes",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Notes",
            "item": [
                {
                    "name": "Get All Notes",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/notes",
                            "host": ["{{base_url}}"],
                            "path": ["notes"]
                        }
                    }
                },
                {
                    "name": "Get Note by ID",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/notes/:id",
                            "host": ["{{base_url}}"],
                            "path": ["notes", ":id"]
                        }
                    }
                },
                {
                    "name": "Create Note",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"note\": \"Sample note\",\n  \"donator\": \"60d5ec49e7b5a72024e3c4e8\",\n  \"user\": \"60d5ec49e7b5a72024e3c4e9\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/notes",
                            "host": ["{{base_url}}"],
                            "path": ["notes"]
                        }
                    }
                },
                {
                    "name": "Update Note",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"note\": \"Updated note content\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/notes/:id",
                            "host": ["{{base_url}}"],
                            "path": ["notes", ":id"]
                        }
                    }
                },
                {
                    "name": "Delete Note",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/notes/:id",
                            "host": ["{{base_url}}"],
                            "path": ["notes", ":id"]
                        }
                    }
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:5000/api/v1",
            "type": "string"
        }
    ]
}
